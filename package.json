{
  "name": "scanbot-barcode-scanner-sdk-example",
  "version": "10.0.0",
  "author": "Scanbot SDK",
  "homepage": "https://scanbot.io",
  "description": "Scanbot Barcode Scanner SDK Example App for Capacitor with Angular",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration development",
    "sync": "npx cap sync",
    "android": "npx cap run android",
    "ios": "npx cap run ios",
    "watch": "ng build --watch --configuration development",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "clean": "rm -r -f node_modules && rm -f package-lock.json && rm -rf www"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.33",
    "@angular/common": "^20.3.33",
    "@angular/compiler": "^20.3.33",
    "@angular/core": "^20.3.33",
    "@angular/forms": "^20.3.33",
    "@angular/platform-browser": "^20.3.33",
    "@angular/platform-browser-dynamic": "^20.3.33",
    "@angular/router": "^20.3.33",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capawesome/capacitor-file-picker": "8.0.2",
    "@ionic/angular": "^8.0.0",
    "capacitor-plugin-scanbot-barcode-scanner-sdk": "10.0.0-rc.4",
    "ionicons": "^8.0.13",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.38",
    "@angular/cli": "^20.3.38",
    "@angular/compiler-cli": "^20.3.33",
    "@angular/language-service": "^20.3.33",
    "@capacitor/cli": "^8.5.2",
    "@ionic/angular-toolkit": "^12.0.0",
    "prettier": "^3.5.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
